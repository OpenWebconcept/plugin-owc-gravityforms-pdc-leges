{
	"name": "plugin/owc-gravityforms-pdc-leges",
	"description": "Haalt automatisch legestarieven op uit een PDC-leges endpoint voor Gravity Forms productvelden.",
	"version": "1.0.0",
	"type": "wordpress-plugin",
	"license": "EUPL-1.2",
	"authors": [
		{
			"name": "Yard | Digital Agency",
			"homepage": "https://www.yard.nl"
		}
	],
	"scripts": {
		"phpcs": "./vendor/squizlabs/php_codesniffer/bin/phpcs",
		"phpcbf": "./vendor/squizlabs/php_codesniffer/bin/phpcbf",
		"test": "vendor/bin/pest",
		"test:coverage": "XDEBUG_MODE=coverage vendor/bin/pest --coverage"
	},
	"autoload": {
		"psr-4": {
			"OWC\\GravityForms\\PdcLeges\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OWC\\GravityForms\\PdcLeges\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"pestphp/pest": "^2.34",
		"10up/wp_mock": "^0.4.2"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"pestphp/pest-plugin": true
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
